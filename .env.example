# Supabase Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Never put a service-role/secret key in a NEXT_PUBLIC_ variable.

# Optional generative copilot. Leave empty to use built-in rules-based recommendations.
# Store this only in server-side environment settings (e.g. Vercel), never NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
